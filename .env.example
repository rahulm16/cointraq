# Local Postgres connection (SPEC §2 uses Neon; local dev uses node-postgres)
DATABASE_URL=postgres://localhost:5432/cointraq

# Single-user auth (SPEC §10)
# Generate with: npm run hash-password -- 'your-password'
# It prints a base64 value (no "$", so nothing to escape) — paste it in as-is.
# The app auto-decodes it. (A raw "$2b$..." bcrypt hash also works if you escape
# each "$" as "\$", but base64 is simpler.)
APP_PASSWORD_HASH=
# Any long random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=
